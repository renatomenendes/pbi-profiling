{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/renatomenendes/pbi-profiling/schemas/profile.rag.chunk.schema.json",
  "title": "pbi-profiling RAG chunk",
  "type": "object",
  "required": ["id", "type", "text", "metadata"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "overview",
        "report_page",
        "table",
        "measure",
        "source",
        "relationship",
        "health_finding",
        "analytical_opportunity",
        "business_context",
        "maintenance_overview",
        "maintenance_hotspot"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    }
  }
}
